# Serviço analítico (FastAPI). Copie para .env (backend/python/.env).
# Este serviço NÃO acessa o ThingSpeak: as leituras vêm da API Java (backend/java).
# Atenção: sem espaço antes/depois do "=" e sem aspas desnecessárias.

# Ambiente: development (padrão) ou production.
# Em production o CORS_ALLOWED_ORIGINS é obrigatório e origens locais são recusadas.
APP_ENV=development

# API Java local. Em Docker use http://java:8080.
JAVA_API_URL=http://localhost:8080

# Credencial de serviço para ler /api/internal/climate-readings na API Java.
# Deve ser idêntica a INTERNAL_API_KEY em backend/java/.env e ter pelo menos 32 caracteres.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=k7Qm2xV9aR4tB8wZ3nL6pY1cD5eF0hJsU

REQUEST_TIMEOUT_SECONDS=12

# Origens do navegador permitidas, separadas por vírgula. Wildcard (*) não é aceito.
# - development: se ficar vazio, usa as origens locais (localhost/127.0.0.1 nas portas 3000, 5173, 5500, 8081).
# - production: obrigatório, apenas origens reais. Exemplo:
#   CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
CORS_ALLOWED_ORIGINS=

# A API usa Bearer token no header Authorization (não cookies), então credenciais ficam desligadas.
CORS_ALLOW_CREDENTIALS=false

# Cache curto do perfil do usuário (/api/auth/me) por token, em segundos (0 desativa; máx. 300).
# Efeito colateral: uma conta desativada no Java pode continuar aceita até este tempo expirar.
PROFILE_CACHE_TTL_SECONDS=45

# /climate/history com resolution=raw é recusado acima deste número de leituras.
HISTORY_MAX_RAW_POINTS=5000

# Retry com backoff exponencial nas chamadas GET à API Java (conexão, timeout, 502/503/504).
# JAVA_RETRY_ATTEMPTS = total de tentativas (1 a 5; 1 desativa). Backoff: 0,25s, 0,5s, 1s...
JAVA_RETRY_ATTEMPTS=3
JAVA_RETRY_BACKOFF_SECONDS=0.25
